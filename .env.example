# Copy this file to ".env" and change the values. Never commit the real .env file.

DB_PASSWORD=choose-a-database-password
JWT_SECRET=a-long-random-string-of-at-least-32-characters
SEED_DEMO=true

# Optional: real LLM answers. Leave AI_API_KEY empty to use the built-in rule engine.
# Works with any OpenAI-compatible API. Check your provider's site for current model names.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
